; Demo project for Inventory & Save Kit (asset-factory product inventory-save-kit)

config_version=5

[application]

config/name="Inventory & Save Kit Demo"
run/main_scene="res://demo/lite/main_lite.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ISKSave="*res://addons/inventory_save_kit/save/isk_save_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[editor_plugins]

enabled=PackedStringArray("res://addons/inventory_save_kit/plugin.cfg")

[gui]

theme/custom="res://demo/ui/demo_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
